        "source_snapshot",
        "contribution",
        "record_routes",
        "publication_scope"
      ],
      "optional_inputs": [
        "visible_transcript",
        "model_provenance",
        "run_receipt"
      ],
      "required_capabilities": [
        "read_project_records",
        "write_project_records"
      ],
      "possible_effects": [
        "preserve_records",
        "publish_with_existing_authority"
      ],
      "outputs": [
        "record_references",
        "coverage",
        "publication_receipts",
        "next_action"
      ],
      "composition_defaults": {
        "limits": {
          "max_depth": 3,
          "max_steps": 8
        },
        "recursive_invocation": false,
        "repeat_requires": "new evidence, a changed question, or a changed representation within the invocation budget"
      },
      "lineage_refs": [
        "docs/research-lessons.md"
      ]
    },
    {
      "id": "bounded-research-loop",
      "version": "0.1.0",
      "kind": "procedure",
      "definition_path": "protocols/bounded-research-loop.md",
      "definition_sha256": "6b69eb8c420e262b0abbcb15858487e32b3ffbdac8366b6979cbcbfb93a1acd8",
      "status": "adopted",
      "execution_mode": "agent_guided",
      "authority": "inherited_only",
      "purpose": "Continue an authorized objective through useful bounded units and recoverable handoffs.",
      "triggers": [
        "explicit continuation request",
        "active authorized unit with a ready successor"
      ],
      "not_needed_when": [
        "no authorized useful work with available inputs"
      ],
      "required_inputs": [
        "objective_reference",
        "source_snapshot",
        "authority_references",
        "current_ownership",
        "resource_bounds"
      ],
      "optional_inputs": [
        "prior_attempt_receipts",
        "capacity_observations",
        "collaborator_availability"
      ],
      "required_capabilities": [
        "read_project_records"
      ],
      "possible_effects": [
        "scoped_research_and_implementation",
        "scoped_execution",
        "preservation",
        "authorized_handoff"
      ],
      "outputs": [
        "unit_result",
        "evidence_and_limits",
        "resource_observations",
        "next_action"
      ],
      "composition_defaults": {
        "limits": {
          "max_depth": 3,
          "max_steps": 8
        },
        "recursive_invocation": false,
        "repeat_requires": "new evidence, a changed question, or a changed representation within the invocation budget"
      },
      "lineage_refs": [
        "docs/research-lessons.md"
      ]
    }
